# Copié automatiquement en .env au premier démarrage. Ne jamais partager .env.
WARAQA_JWT_SECRET=GENERATED_AT_FIRST_START
WARAQA_JWT_EXPIRATION=8h
WARAQA_PORT=3000
WARAQA_HOST=127.0.0.1
WARAQA_DB_PATH=./data/waraqa.sqlite
WARAQA_FILES_PATH=./data/files
# Aucune clé nécessaire aujourd'hui. Renseigner demain, puis redémarrer.
ANTHROPIC_API_KEY=
WARAQA_IA_MODEL=claude-sonnet-5
# Route OCR historique uniquement ; la nouvelle interface utilise Réglages > Assistant IA.
WARAQA_IA_MODE=mock

# OAuth Drive : laisser vide tant qu’aucun projet Google et compte n’est autorisé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/workspace/drive/callback
WARAQA_IA_CONCURRENCY=1
# Campagne payante : budget explicite obligatoire, jamais une clé dans ce fichier d’exemple.
WARAQA_TEST_BUDGET_USD=
