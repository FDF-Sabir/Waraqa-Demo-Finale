# Copié automatiquement en .env au premier démarrage. Ne jamais partager .env.
WARAQA_JWT_SECRET=GENERATED_AT_FIRST_START
WARAQA_JWT_EXPIRATION=8h
WARAQA_PORT=3000
WARAQA_HOST=127.0.0.1
WARAQA_DB_PATH=./data/waraqa.sqlite
WARAQA_FILES_PATH=./data/files

# ── IA (Anthropic Claude) ──────────────────────────────────────────────────────
# Méthode recommandée : Réglages → Assistant IA → coller la clé → Tester la connexion.
# L'application écrit alors la clé ici elle-même (aucun redémarrage nécessaire).
# Vous pouvez aussi la saisir à la main puis redémarrer. Ne jamais la mettre ailleurs.
ANTHROPIC_API_KEY=
# Uniquement pour une clé créée avec la portée « Organisation » (sinon laisser vide).
ANTHROPIC_WORKSPACE_ID=
# Appels IA simultanés (1 à 4) et délai maximal d'un appel (ms).
WARAQA_IA_CONCURRENCY=2
WARAQA_IA_TIMEOUT_MS=180000
# Modèle, niveau de réflexion et budget mensuel se règlent dans Réglages → Assistant IA.
# Route OCR historique /api/ocr uniquement (l'interface utilise les réglages) : mock | live.
WARAQA_IA_MODE=mock
WARAQA_IA_MODEL=claude-sonnet-5

# OAuth Drive : laisser vide tant qu’aucun projet Google et compte n’est autorisé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/workspace/drive/callback
# Plafond de la validation réelle `npm run test:ia` (USD). Jamais de clé dans ce fichier d’exemple.
WARAQA_TEST_BUDGET_USD=0.30
