# Copié automatiquement en .env au premier démarrage. Ne jamais partager .env.
# Les lignes ajoutées dans une nouvelle version sont complétées automatiquement au démarrage,
# sans jamais modifier les valeurs déjà présentes (clé API, secret, identifiants Google).

# Profil : online = l'application locale se comporte comme la version hébergée
# (IA connectée dès que la clé existe, Google Drive synchronisé automatiquement).
# local = ancien mode démo, bascule manuelle et aucun transfert automatique.
WARAQA_PROFILE=online
# Ouvre le navigateur sur Waraqa au démarrage (0 pour désactiver).
WARAQA_OPEN_BROWSER=1
WARAQA_JWT_SECRET=GENERATED_AT_FIRST_START
WARAQA_JWT_EXPIRATION=8h
WARAQA_PORT=3000
WARAQA_HOST=127.0.0.1
WARAQA_DB_PATH=./data/waraqa.sqlite
WARAQA_FILES_PATH=./data/files

# ── IA (Anthropic Claude) ──────────────────────────────────────────────────────
# Méthode recommandée : Réglages → Assistant IA → coller la clé → Tester la connexion.
# L'application écrit alors la clé ici elle-même (aucun redémarrage nécessaire).
# Vous pouvez aussi la saisir à la main puis redémarrer. Ne jamais la mettre ailleurs.
ANTHROPIC_API_KEY=
# Uniquement pour une clé créée avec la portée « Organisation » (sinon laisser vide).
ANTHROPIC_WORKSPACE_ID=
# Appels IA simultanés (1 à 4) et délai maximal d'un appel (ms).
WARAQA_IA_CONCURRENCY=2
WARAQA_IA_TIMEOUT_MS=180000
# Modèle, niveau de réflexion et budget mensuel se règlent dans Réglages → Assistant IA.
# Route OCR historique /api/ocr uniquement (l'interface utilise les réglages) : mock | live.
# En profil online, la route passe en réel dès que la clé existe, quelle que soit cette valeur.
WARAQA_IA_MODE=live
WARAQA_IA_MODEL=claude-sonnet-5

# ── Google Drive ───────────────────────────────────────────────────────────────
# Méthode recommandée : Réglages → Intégrations → charger le JSON du client OAuth Google.
# L'application écrit alors GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET ici elle-même.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vide = http://localhost:<WARAQA_PORT>/api/workspace/drive/callback (à déclarer dans Google Cloud).
GOOGLE_REDIRECT_URI=
# Seul ce compte Google peut être connecté (e-mail vérifié par Google). Vide = tout compte.
GOOGLE_ALLOWED_EMAIL=saberrochdi509@gmail.com
# Plafond de la validation réelle `npm run test:ia` (USD). Jamais de clé dans ce fichier d’exemple.
WARAQA_TEST_BUDGET_USD=0.30
